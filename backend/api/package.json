{
  "name": "@boba/api",
  "version": "0.1.0",
  "private": true,
  "description": "BOBA API service — Express HTTP gateway exposing v1 endpoints.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts",
    "test": "vitest run --config vitest.config.ts --reporter=verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "lint": "tsc --noEmit",
    "validate-spec": "node --import tsx/esm -e \"import { openApiSpec } from './src/openapi.ts'; const s=openApiSpec; if(s.openapi!=='3.0.3') throw new Error('bad version'); if(!s.paths||Object.keys(s.paths).length===0) throw new Error('no paths'); console.log('OpenAPI spec OK — paths:', Object.keys(s.paths).length);\""
  },
  "dependencies": {
    "@boba/database": "*",
    "@boba/llm-gateway": "*",
    "@boba/logger": "*",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
