# BOBA frontend environment — copy to .env.local and fill in.
#   cp frontend/.env.example frontend/.env.local

# Leave empty in local dev to use relative paths proxied by Vite to the API
# (see vite.config.ts → server.proxy). Set to the API origin in other setups.
VITE_API_URL=

# Google OAuth client ID (Web application) from Google Cloud Console.
# Authorized JavaScript origin:  http://localhost:5173
# Authorized redirect URI:       http://localhost:5173/auth/callback
VITE_GOOGLE_CLIENT_ID=

# Optional — defaults to <origin>/auth/callback.
# VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Run the SPA on mock data only (no backend). Default false.
VITE_USE_MOCK_DATA=false
